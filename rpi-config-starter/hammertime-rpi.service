[Unit]
Description=HammerTime
Wants=hammertime-kiosk.service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/HammerTime
ExecStart=/home/pi/.nvm/versions/node/v24.21.0/bin/node /home/pi/HammerTime/index.js
Restart=on-failure
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target